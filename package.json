{
  "name": "open-endfield-map-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "generate:announcements": "node scripts/generate-announcements-json.cjs",
    "generate:git-authors": "node scripts/generate-git-authors-snapshot.cjs",
    "generate:rss": "node scripts/generate-rss.mjs",
    "build": "pnpm run generate:announcements && pnpm run generate:git-authors && pnpm run generate:rss && pnpm run generate:ud-subsets && next build",
    "dev": "pnpm run generate:git-authors && next dev --webpack",
    "dev:turbo": "pnpm run generate:git-authors && next dev --turbopack",
    "dev:cloudflare": "pnpm run generate:git-authors && NEXTJS_ENV=cloudflare-dev next dev --webpack",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && NODE_OPTIONS=--dns-result-order=ipv4first opennextjs-cloudflare deploy && pnpm run purge:announcements-cache",
    "upload": "opennextjs-cloudflare build && NODE_OPTIONS=--dns-result-order=ipv4first opennextjs-cloudflare upload",
    "generate:geist-fonts": "node scripts/generate-geist-fonts.cjs",
    "generate:ud-subsets": "node scripts/subset-ud-fonts.cjs",
    "fetch:ud-fonts": "node scripts/fetch-ud-fonts.cjs",
    "purge:announcements-cache": "node scripts/purge-announcements-cache.cjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "feed": "^5.2.0",
    "fumadocs-core": "^16.19.0",
    "fumadocs-mdx": "^15.6.0",
    "fumadocs-ui": "^16.19.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "progressive-blur": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.108.2",
    "typescript": "^5.6.0",
    "wrangler": "^4.160.1"
  }
}

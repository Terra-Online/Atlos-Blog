{
  "name": "open-endfield-map-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "generate:announcements": "node scripts/generate-announcements-json.cjs",
    "build": "pnpm run generate:announcements && next build",
    "dev": "next dev",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "preview": "pnpm run generate:announcements && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm run generate:announcements && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "pnpm run generate:announcements && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "sync:blog-images": "node scripts/sync-blog-images-to-r2.cjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "feed": "^5.2.0",
    "fumadocs-core": "^14.0.0",
    "fumadocs-mdx": "^11.0.0",
    "fumadocs-ui": "^14.0.0",
    "lucide-react": "^0.575.0",
    "next": "^15.0.0",
    "progressive-blur": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sass": "^1.97.3",
    "typescript": "^5.6.0",
    "wrangler": "^4.69.0"
  }
}
